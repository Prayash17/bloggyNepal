 {
  "provinces": [
    {
      "_id": "province-koshi",
      "_type": "province",
      "name": "Koshi",
      "officialName": "Koshi Province",
      "slug": {
        "_type": "slug",
        "current": "koshi"
      },
      "number": 1,
      "capital": "Biratnagar",
      "headquarters": "Biratnagar",
      "population": 4961412,
      "area": 25905,
      "noOfDistricts": 14,
      "body": [
        {
          "_type": "block",
          "_key": "p1body1",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "text": "Koshi Province (formerly Province No. 1) is the easternmost province of Nepal, home to Mount Everest, lush tea gardens, and diverse ethnic communities. It borders India to the south and Tibet (China) to the north."
            }
          ]
        }
      ],
      "geography": [
        {
          "_type": "block",
          "_key": "p1geo1",
          "children": [
            {
              "_type": "span",
              "text": "Koshi Province stretches from the Terai plains in the south to the world's highest peaks including Everest, Kanchenjunga, and Makalu in the north."
            }
          ]
        }
      ]
    },
    {
      "_id": "province-madhesh",
      "_type": "province",
      "name": "Madhesh",
      "officialName": "Madhesh Province",
      "slug": {
        "_type": "slug",
        "current": "madhesh"
      },
      "number": 2,
      "capital": "Janakpurdham",
      "headquarters": "Janakpurdham",
      "population": 6114600,
      "area": 9661,
      "noOfDistricts": 8,
      "body": [
        {
          "_type": "block",
          "_key": "p2body1",
          "children": [
            {
              "_type": "span",
              "text": "Madhesh Province lies in the southern Terai region of Nepal. It is the most densely populated province and is known for its rich Maithili culture, Janakpur's mythological significance, and fertile agricultural land."
            }
          ]
        }
      ]
    },
    {
      "_id": "province-bagmati",
      "_type": "province",
      "name": "Bagmati",
      "officialName": "Bagmati Province",
      "slug": {
        "_type": "slug",
        "current": "bagmati"
      },
      "number": 3,
      "capital": "Hetauda",
      "headquarters": "Hetauda",
      "population": 6116866,
      "area": 20300,
      "noOfDistricts": 13,
      "body": [
        {
          "_type": "block",
          "_key": "p3body1",
          "children": [
            {
              "_type": "span",
              "text": "Bagmati Province is the most developed province of Nepal, home to the capital city Kathmandu. It houses UNESCO World Heritage Sites and major economic hubs."
            }
          ]
        }
      ]
    },
    {
      "_id": "province-gandaki",
      "_type": "province",
      "name": "Gandaki",
      "officialName": "Gandaki Province",
      "slug": {
        "_type": "slug",
        "current": "gandaki"
      },
      "number": 4,
      "capital": "Pokhara",
      "headquarters": "Pokhara",
      "population": 2466427,
      "area": 21504,
      "noOfDistricts": 11,
      "body": [
        {
          "_type": "block",
          "_key": "p4body1",
          "children": [
            {
              "_type": "span",
              "text": "Gandaki Province is famous for the Annapurna and Manaslu mountain ranges, the sacred Muktinath temple, and the beautiful city of Pokhara — Nepal's tourism capital."
            }
          ]
        }
      ]
    },
    {
      "_id": "province-lumbini",
      "_type": "province",
      "name": "Lumbini",
