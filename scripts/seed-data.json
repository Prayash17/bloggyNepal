      "population": 1688412,
      "area": 27984,
      "noOfDistricts": 10,
      "body": [
        {
          "_type": "block",
          "_key": "p6body1",
          "children": [
            {
              "_type": "span",
              "text": "Karnali Province is the largest province by area and the least populated. Home to Shey-Phoksundo National Park and Rara Lake — the largest lake in Nepal."
            }
          ]
        }
      ]
    },
    {
